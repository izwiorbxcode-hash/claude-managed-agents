{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["apps/api/**", "packages/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "warn"
          }
        }
      }
    },
    {
      "includes": ["**/static/**", "**/dist/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}