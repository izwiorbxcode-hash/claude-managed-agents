{
  "name": "izwa-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "IzwaAI — the learned-data layer for specialized intelligence, beginning with African languages",
  "packageManager": "bun@1.3.10",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "workers/*",
      "tooling/*",
      "infrastructure/*"
    ],
    "catalog": {
      "effect": "^3.22.1",
      "hono": "^4.12.32",
      "drizzle-orm": "^0.45.2",
      "drizzle-kit": "^0.31.7",
      "better-auth": "1.7.1",
      "@better-auth/drizzle-adapter": "1.7.1",
      "better-auth-paystack": "3.1.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@cloudflare/workers-types": "^5.20260728.1",
      "@types/node": "^26.2.0",
      "vitest": "^4.1.5",
      "wrangler": "^4.59.3",
      "turbo": "^2.10.7",
      "ultracite": "7.9.4",
      "@biomejs/biome": "2.5.3"
    }
  },
  "overrides": {
    "@ai-sdk/provider": "3.0.15",
    "@ai-sdk/provider-utils": "4.0.46"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@unsung/api-worker",
    "dev:web": "vite",
    "build": "turbo run build && vite build",
    "build:web": "vite build",
    "typecheck": "turbo run check-types",
    "typecheck:legacy": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "ultracite check",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo run test",
    "test:legacy": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --cwd apps/api",
    "db:generate": "turbo run db:generate --filter=@unsung/db",
    "db:migrate": "wrangler d1 migrations apply DB --local --cwd apps/api",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --cwd apps/api",
    "deploy": "turbo run deploy --filter=@unsung/infra",
    "deploy:legacy": "npm run build && wrangler deploy",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "vpc:sync": "node scripts/sync-vpc-bindings.mjs",
    "frontend:dev": "vite"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.10.0",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "effect": "catalog:",
    "redoc": "^2.5.2",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "^6.0.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.8",
    "@anthropic-ai/sdk": "https://app.stainless.com/pkg/s/anthropic-typescript/11dd7e25acfec7caffc11c06d11629f42846b595/dist.tar.gz",
    "@cloudflare/codemode": "^0.3.4",
    "@cloudflare/kumo": "^2.0.2",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/sandbox": "^0.10.1",
    "@cloudflare/shell": "^0.3.6",
    "@cloudflare/think": "^0.5.3",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "agents": "^0.12.4",
    "ai": "^6.0.174",
    "hono": "catalog:",
    "marked": "^14.1.4",
    "minimatch": "^10.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "zod": "catalog:"
  }
}
